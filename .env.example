# --- Neon PostgreSQL ---
# Pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection, used by Prisma migrations and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-32+-random-bytes"
# Public base URL of the deployment (no trailing slash). On Vercel set it to your production domain.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seed: initial staff accounts (only used by `npm run db:seed`) ---
# Staff accounts are created only if these are set. Use strong unique passwords.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_MANAGER_EMAIL=""
SEED_MANAGER_PASSWORD=""
SEED_KITCHEN_EMAIL=""
SEED_KITCHEN_PASSWORD=""

# --- Public demo accounts (portfolio showcase) ---
# admin@ / manager@ / kitchen@ / customer@foodhub.example.com share this password. Visitors use the one-click
# demo buttons on the login page, so the password is not displayed, but treat it as public: never reuse a real one.
# Demo accounts cannot change roles, settings, passwords or delete data. Leave empty to disable the demo.
DEMO_PASSWORD=""

# --- Daily showcase reset (Vercel Cron, see vercel.json; runs 02:00 Almaty) ---
# Restores the seed menu/promo codes, clears demo-account data and deletes orders older than the retention window.
# Only for the public showcase. NEVER enable it on a real restaurant's database.
DEMO_RESET_ENABLED="false"
DEMO_ORDER_RETENTION_DAYS="7"
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes. 16+ random characters:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""

# --- Tests ---
# A separate Neon branch for integration/E2E tests (data is wiped by integration tests!).
TEST_DATABASE_URL=""
