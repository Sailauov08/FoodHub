# --- Neon PostgreSQL ---
# Pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection, used by Prisma migrations and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-32+-random-bytes"
# Public base URL of the deployment (no trailing slash). On Vercel set it to your production domain.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seed: initial staff accounts (only used by `npm run db:seed`) ---
# Staff accounts are created only if these are set. Use strong unique passwords.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_MANAGER_EMAIL=""
SEED_MANAGER_PASSWORD=""
SEED_KITCHEN_EMAIL=""
SEED_KITCHEN_PASSWORD=""

# --- Public demo accounts (portfolio showcase) ---
# admin@ / manager@ / kitchen@ / customer@foodhub.example.com share this password; it is shown on the login page,
# so never reuse a real password here. Demo accounts cannot change roles, settings or passwords.
DEMO_PASSWORD=""

# --- Tests ---
# A separate Neon branch for integration/E2E tests (data is wiped by integration tests!).
TEST_DATABASE_URL=""
